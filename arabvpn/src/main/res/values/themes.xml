<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ArabVPN" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#101828</item>
        <item name="android:statusBarColor">#101828</item>
    </style>

    <style name="Theme.ArabVPN.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#101828</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_arab_vpn</item>
        <item name="windowSplashScreenIconBackgroundColor">#101828</item>
        <item name="postSplashScreenTheme">@style/Theme.ArabVPN</item>
    </style>

    <style name="Theme.ArabVPN.Transparent" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#12B76A</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
